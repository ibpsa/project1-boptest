# Builds the MinIO server binary from source.
#
# The MINIO_RELEASE build arg pins the exact upstream release tag
# (https://github.com/minio/minio/releases) that will be checked out and
# compiled. Override it via `--build-arg MINIO_RELEASE=...` or the
# MINIO_RELEASE variable in .env to change versions.

# This code is from the alfalfa repository at https://github.com/NatLabRockies/alfalfa.
# distributed under the 3-clause BSD License in service/LICENSE.md.

FROM golang:1.24-alpine AS build

ARG MINIO_RELEASE

ENV CGO_ENABLED=0
ENV GOSUMDB=off

RUN apk add --no-cache git bash make perl ca-certificates

WORKDIR /build

RUN git clone --depth 1 --branch ${MINIO_RELEASE} https://github.com/minio/minio.git .

RUN make build

# **** Minimal runtime image ****
FROM alpine:3.19

RUN apk add --no-cache ca-certificates

COPY --from=build /build/minio /usr/bin/minio

EXPOSE 9000 9001

VOLUME ["/data"]

ENTRYPOINT ["minio"]
CMD ["server", "/data"]
