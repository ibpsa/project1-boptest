  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-presigned-post": "^3.1112.0",
    "express": "^4.22.2",
    "express-validator": "^6.15.0",
    "got": "^11.8.6",
    "msgpackr": "^1.12.1",
    "redis": "^3.1.2",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.3",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7"
  }
